# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Secrets live in Bitwarden. Pull them with the bw CLI, e.g.:
#   bw get password "recipe-book / anthropic api key"
#
# Everything here is read by src/recipebook/config.py via pydantic-settings.

# Server-side only. Never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...

# The database password. docker-compose builds both the server's credentials
# and the app container's connection string from it.
#
# Postgres only applies this when it first initialises its data directory, so
# set it BEFORE the first `docker compose up`. Changing it afterwards does
# nothing until the volume is destroyed.
#
# Leave it as-is locally; change it on the server. This repository is public,
# so a password that appears in it is not a password.
POSTGRES_PASSWORD=recipebook

# How the host reaches the database: uvicorn run directly, and the recipebook
# CLI. Port 5433 so this never collides with a Postgres already on the host.
#
# The app *container* does not use this — inside Docker the database is
# db:5432, and docker-compose.yml builds that URL itself.
DATABASE_URL=postgresql+psycopg://recipebook:recipebook@localhost:5433/recipebook

# Bind to loopback only. `tailscale serve --bg 8000` fronts this with TLS
# and exposes it to the tailnet; the app itself never needs to know.
HOST=127.0.0.1
PORT=8000

# claude-opus-5 is the default. Effort trades cost against how carefully a
# revision is reasoned through; see docs/decisions.md.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
