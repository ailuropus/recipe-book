# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Secrets live in Bitwarden. Pull them with the bw CLI, e.g.:
#   bw get password "recipe-book / anthropic api key"
#
# Everything here is read by src/recipebook/config.py via pydantic-settings.

# Server-side only. Never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Matches the credentials in docker-compose.yml for local development.
# Port 5433 so this never collides with a Postgres already on the host.
DATABASE_URL=postgresql+psycopg://recipebook:recipebook@localhost:5433/recipebook

# Bind to loopback only. `tailscale serve --bg 8000` fronts this with TLS
# and exposes it to the tailnet; the app itself never needs to know.
HOST=127.0.0.1
PORT=8000

# claude-opus-5 is the default. Effort trades cost against how carefully a
# revision is reasoned through; see docs/decisions.md.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
